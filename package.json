{
  "name": "foglio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Foglio di calcolo: applicazione di calcolo standalone distribuita come singolo file HTML.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node tools/build.js",
    "build:timetable": "node tools/build-timetable.js",
    "build:loom": "node tools/build-loom.js",
    "dev": "node tools/serve.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:timetable && npm run test:loom",
    "test:unit": "node --import ./tools/load-scittle.js --test tests/unit/*.test.js",
    "test:integration": "node --import ./tools/load-scittle.js --test tests/integration/*.test.js",
    "test:timetable": "node --test --test-skip-pattern='external OFD fixture' tests/timetable/*.test.js",
    "test:integration:ofd": "node --test --test-name-pattern='external OFD fixture' tests/timetable/*.test.js",
    "test:loom": "node --import ./tools/load-scittle.js --test tests/loom/*.test.js",
    "test:perf:timetable": "node tests/timetable/recalculation.performance.js",
    "test:perf:optimization": "node tests/timetable/optimization.performance.js",
    "test:e2e:timetable": "node --test --test-skip-pattern='external OFD fixture' tests/timetable/standalone.test.js",
    "test:e2e": "node tools/build.js && node --test tests/e2e/*.test.js",
    "check": "npm test && npm run build && node tools/verify-artifact.js && node --test tests/e2e/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "@openai/codex": "^0.162.1",
    "marked": "18.1.1",
    "scittle": "0.8.33"
  }
}
